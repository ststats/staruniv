{
  "name": "staruniv",
  "private": true,
  "description": "테스트(node --test)와 배포용 JS·CSS 압축(scripts/minify_assets.mjs). 달력 캡처는 scripts/capture_calendar.mjs가 크롬으로 찍는다.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:pages": "node --test tests/browser/*.test.js",
    "minify": "node scripts/minify_assets.mjs docs",
    "format": "prettier --write 'templates/assets/*.js' 'templates/assets/*.css' 'templates/assets/style/*.css' 'tests/*.js' 'tests/browser/*.js' '!templates/assets/purify.min.js' '!templates/assets/mp4-muxer.js'",
    "format:check": "prettier --check 'templates/assets/*.js' 'templates/assets/*.css' 'templates/assets/style/*.css' 'tests/*.js' 'tests/browser/*.js' '!templates/assets/purify.min.js' '!templates/assets/mp4-muxer.js'"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "esbuild": "0.25.10",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "terser": "5.44.0"
  }
}
