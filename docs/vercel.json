{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "routes": [
    {
      "src": "^/(.*)$",
      "continue": true,
      "headers": {
        "Strict-Transport-Security": "max-age=63072000",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
      }
    },
    {
      "src": "^/(?:(?:members|records|schedule|stats|tier|tools|video)/(?:index\\.html)?|index\\.html|multiview\\.html|admin(?:-[a-z]+)?\\.html)?$",
      "continue": true,
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api-channel.sooplive.com https://www.youtube.com; frame-src 'self' https://www.youtube-nocookie.com https://*.sooplive.co.kr https://*.sooplive.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
      }
    },
    {
      "src": "^/(.*)\\.(js|css)$",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "continue": true,
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "^/calmmon-rider\\.html$",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "continue": true,
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "^/calendar\\.png$",
      "dest": "https://czqxedrayvgxirvlveon.supabase.co/storage/v1/object/public/staruniv-media/calendar.png",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, proxy-revalidate",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store",
        "Pragma": "no-cache",
        "Expires": "0"
      }
    },
    {
      "src": "^/((?:[^/]+/)*[^/.]+)$",
      "status": 308,
      "headers": {
        "Location": "/$1/"
      }
    },
    {
      "src": "^/((?:[^/]+/)*)$",
      "dest": "https://ststats.github.io/staruniv/$1index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "https://ststats.github.io/staruniv/$1"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  }
}
