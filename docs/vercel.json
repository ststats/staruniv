{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "https://ststats.github.io/staruniv/index.html"
    },
    {
      "source": "/:path*/",
      "destination": "https://ststats.github.io/staruniv/:path*/index.html"
    },
    {
      "source": "/:path*",
      "destination": "https://ststats.github.io/staruniv/:path*"
    }
  ]
}
