# 파이프라인 중간 산출물 (match_link.py의 링크 캐시). data/*.json, docs/ 산출물과 달리
# 커밋 대상이 아니다 - db.json 해시가 바뀌면 자동으로 다시 계산되므로 저장소에 남길 이유가 없다.
build/

# 파이썬
__pycache__/
*.pyc
.venv/
venv/

# Node(테스트용)
node_modules/

# 원자적 쓰기(os.replace) 도중 남을 수 있는 임시 파일. 정상 실행이면 곧바로 교체되어
# 사라지지만, 스크립트가 중간에 죽은 채로 남아 있으면 실수로 커밋되지 않게 막아준다.
*.tmp
*.new/

# 에디터/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Supabase elo_*가 원본이다. 이 파일은 Actions/로컬 빌드 때 DB에서 재생성하는 호환 캐시.
data/eloboard.json

# 빌드 결과. GitHub Actions가 빌드해서 Pages에 바로 배포한다(저장소에 커밋하지 않음).
# 로컬 확인은 python scripts/build_html.py 뒤 docs/를 열면 된다.
docs/
# 빌드 캐시(Supabase export)
data/db.json
data/render_stats.json
